# ---------------------------------------------------------------------------
# Niche Automation Script Hub — Python .gitignore
# Keeps temporary files, caches, virtual environments, and user data
# OUT of GitHub. Empty input/output folders stay in the repo via .gitkeep.
# ---------------------------------------------------------------------------

# --- Virtual environments (never upload these) ---
# .uv holds the launchers' private copy of uv and Python
.uv/
.venv/
venv/
env/
ENV/
.env/
.python-version

# --- Secrets / local config (never upload these) ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# --- Python cache & build artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# --- Test / coverage / type checkers ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# --- Jupyter notebooks checkpoints ---
.ipynb_checkpoints/

# --- OS junk ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Tool input / output data (keep folders, ignore user files) ---
# Image Compressor
input_images/*
!input_images/.gitkeep
optimized_images/*
!optimized_images/.gitkeep

# Spreadsheet Cleaner
input_spreadsheets/*
!input_spreadsheets/.gitkeep
cleaned_spreadsheets/*
!cleaned_spreadsheets/.gitkeep

# PDF Text & Image Extractor
input_pdfs/*
!input_pdfs/.gitkeep
extracted_pdfs/*
!extracted_pdfs/.gitkeep

# Audio-to-Text Transcriber
input_audio/*
!input_audio/.gitkeep
transcripts/*
!transcripts/.gitkeep

# Bulk File Renamer
files_to_rename/*
!files_to_rename/.gitkeep

# Website-to-Markdown Scraper (urls.txt is your personal reading list)
scraped_articles/*
!scraped_articles/.gitkeep
urls.txt

# Background Remover
input_photos/*
!input_photos/.gitkeep
no_background/*
!no_background/.gitkeep

# Scanned Document Reader (OCR)
input_scans/*
!input_scans/.gitkeep
scanned_text/*
!scanned_text/.gitkeep

# Mail-Merge Certificates & Letters (example files are created on first run)
mail_merge/*
!mail_merge/.gitkeep
merged_documents/*
!merged_documents/.gitkeep

# Spreadsheet Merger
spreadsheets_to_merge/*
!spreadsheets_to_merge/.gitkeep
merged_spreadsheets/*
!merged_spreadsheets/.gitkeep

# Video Subtitle Maker
input_videos/*
!input_videos/.gitkeep
subtitles/*
!subtitles/.gitkeep

# Meeting Notes Summarizer (reads transcripts/, above)
meeting_notes/*
!meeting_notes/.gitkeep

# Duplicate File Finder
files_to_check/*
!files_to_check/.gitkeep
duplicates_review/
duplicates_report.csv
.duplicates_last_run.txt

# Demo GIFs are kept (they're small); ignore other bulky media / dumps anywhere
*.webp
!docs/**/*.webp
~$*
*.tmp
*.temp
